# ─── LumaFlow frontend ────────────────────────────────────────────────────
# Copy to .env.local and adjust. Every value below is Stellar **testnet**.

# ─── Soroban vault ────────────────────────────────────────────────────────────
VITE_VAULT_CONTRACT_ID=CAVF2IT2KTOES576A2WNIIQVIBNHWVGMSIRE55XFJGB6WD3R4HWP2INT

# ─── Soroban stop vault (V3) ──────────────────────────────────────────────────
# Optional, and deliberately without a fallback. Unset means the console offers
# limit orders only; there is no address to guess, and a stop form addressed to
# nothing is worse than no stop form. Fill this in once V3 is deployed.
# VITE_STOP_VAULT_CONTRACT_ID=

VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# ─── Anchor (TR Mock Anchor — TRY ⇄ USDC) ─────────────────────────────────────
# The home domain is the ONLY anchor value the client needs: SEP-1 discovery
# reads /.well-known/stellar.toml and derives the auth, transfer, KYC and quote
# endpoints, the signing key and the asset from it. Point this at a production
# anchor and the same client works unchanged.
VITE_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev

# Fallback only — the issuer is read from the anchor's TOML at runtime and the
# TOML value always wins. This exists so the UI can render before discovery
# resolves.
VITE_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ─── Soroban token addresses ──────────────────────────────────────────────────
# Stellar Asset Contract for the anchor's classic USDC — this is the bridge
# between the classic asset the anchor pays and the Soroban token the vault
# holds. Derive it with:
#   stellar contract id asset --asset USDC:<issuer> --network testnet
# (deploy once with `stellar contract asset deploy` if it has never been used).
VITE_USDC_SAC_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Native XLM SAC — the asset the vault swaps into by default.
VITE_TOKEN_OUT_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
